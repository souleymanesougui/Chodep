// ============================================================
// CHODEP — Règles de sécurité Cloud Firestore
//
// Principe :
//  - Le contenu public (formations, événements, articles, galerie,
//    équipe, partenaires, paramètres) est lisible par tous, mais
//    seul un administrateur authentifié et déclaré dans la
//    collection "admins" peut créer/modifier/supprimer.
//  - Les inscriptions et les messages peuvent être CRÉÉS par
//    n'importe quel visiteur (formulaires publics), mais ne
//    peuvent être LUS, MODIFIÉS ou SUPPRIMÉS que par un
//    administrateur — jamais par le visiteur qui les a envoyés.
//
// Pour déclarer un administrateur : crée un document dans
// la collection "admins" dont l'ID est l'UID Firebase Auth
// de ce compte, ex. admins/{uid} = { role: "admin" }.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Autorise UNIQUEMENT l'incrémentation atomique du compteur "inscrits"
    // (+1 exactement) et le passage du statut à "complet" quand la dernière
    // place est prise — déclenché par la transaction d'inscription publique.
    // Aucun autre champ ne peut être modifié par un visiteur.
    function isCapacityFlip() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['inscrits', 'statut']) &&
             request.resource.data.inscrits == resource.data.inscrits + 1 &&
             (request.resource.data.statut == resource.data.statut ||
              request.resource.data.statut == 'complet');
    }

    // --- Contenu public en lecture, administrable uniquement ---
    match /formations/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isCapacityFlip();
    }
    match /evenements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /articles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /galerie/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /equipe/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /partenaires/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /parametres/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Formulaires publics : création libre, lecture/gestion admin uniquement ---
    match /inscriptions/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Index technique servant uniquement à empêcher un même email de
    // s'inscrire deux fois à la même formation (ne contient aucune donnée
    // personnelle : juste l'existence d'un identifiant formationId_email).
    match /inscriptions_index/{id} {
      allow get, create: if true;
      allow list, update, delete: if isAdmin();
    }

    // Collection technique utilisée par l'extension Firebase "Trigger Email"
    // pour l'envoi des notifications (voir README → section Notifications).
    match /mail/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Compteur de visites (statistiques/visites) : écriture publique limitée
    // aux seuls champs de comptage, lecture réservée à l'administration.
    match /statistiques/{id} {
      allow read: if isAdmin();
      allow create: if id == 'visites' &&
        request.resource.data.keys().hasOnly(['total','pages','derniereVisite']);
      allow update: if id == 'visites' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total','pages','derniereVisite']);
    }

    // --- Comptes administrateurs et utilisateurs internes ---
    match /admins/{id} {
      allow read: if isAdmin();
      allow write: if false; // à créer manuellement depuis la Console Firebase
    }
    match /users/{id} {
      allow read, write: if isAdmin();
    }
  }
}

