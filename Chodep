    const real = snap.docs.map(d => d.data()).filter(p => p.publie !== false);
    if(real.length) items = real;
  }catch(err){ console.warn("Firestore indisponible, partenaires de démonstration.", err.message); }

  document.getElementById("partnersGrid").innerHTML = items.map(p => `
