<script type="module">
import { escapeHtml } from "./js/main.js";
const FALLBACK_TEAM = [
  { nom:"Nom Prénom", fonction:"Fonction", image:"" },
  { nom:"Nom Prénom", fonction:"Fonction", image:"" },
  { nom:"Nom Prénom", fonction:"Fonction", image:"" },
  { nom:"Nom Prénom", fonction:"Fonction", image:"" },
];
async function loadTeam(){
  let items = FALLBACK_TEAM;
  try{
    const { db } = await import("./js/firebase-config.js");
    const { collection, getDocs, query, orderBy } = await import("https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js");
    const snap = await getDocs(query(collection(db, "equipe"), orderBy("ordre","asc")));
    const real = snap.docs.map(d => d.data()).filter(m => m.publie !== false);
    if(real.length) items = real;
  }catch(err){ console.warn("Firestore indisponible, équipe de démonstration.", err.message); }

  document.getElementById("teamGrid").innerHTML = items.map(m => `
    <div class="team-card reveal in">
      <div class="img" style="background:var(--ink-2); ${m.image?`background-image:url('${m.image}'); background-size:cover; background-position:center;`:""}"></div>
      <h3>${escapeHtml(m.nom)}</h3>
      <p class="body-text" style="font-size:0.88rem;">${escapeHtml(m.fonction||"")}</p>
    </div>`).join("");
}
loadTeam();
</script>
