// ============================================================
// CHODEP — Règles de sécurité Firebase Storage
// Les fichiers (photos de formations, galerie, équipe, etc.)
// sont lisibles publiquement, mais seul un administrateur
// authentifié peut téléverser ou supprimer un fichier.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
  }
}
